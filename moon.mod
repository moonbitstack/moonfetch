name = "moonbitstack/moonfetch"

version = "0.1.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonfetch"

license = "Apache-2.0"

keywords = [
  "http",
  "http-client",
  "client",
  "fetch",
  "requests",
  "httpx",
  "reqwest",
  "async",
  "http1",
  "http2",
  "https",
  "tls",
  "alpn",
  "redirect",
  "gzip",
  "deflate",
  "json",
  "form",
  "moonbit",
]

description = "An HTTP client for MoonBit, synchronous or asynchronous."

source = "src"

import {
  "moonbitstack/moonnet@0.1.7",
  "moonbitstack/moontls@0.9.6",
  "moonbitstack/mooncred@0.6.7",
  "moonbitstack/moonhttp@0.15.3",
  "moonbitstack/moonurl@0.2.3",
  "moonbitstack/moonzip@0.3.2",
  "moonbitlang/async@0.22.5",
}
