name = "moonbitstack/moonfetch"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonfetch"

license = "Apache-2.0"

keywords = [ "http", "client", "fetch", "async", "requests", "moonbit" ]

description = "moonfetch — an HTTP client for MoonBit (← requests + aiohttp): the same call written once, synchronous or asynchronous, over native sockets or the browser's fetch."

preferred_target = "wasm-gc"
