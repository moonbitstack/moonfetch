name = "moonbitstack/moonfetch"

version = "0.1.6"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonfetch"

license = "Apache-2.0"

keywords = [
  "http",
  "http-client",
  "client",
  "fetch",
  "requests",
  "httpx",
  "reqwest",
  "async",
  "http1",
  "http2",
  "https",
  "tls",
  "alpn",
  "redirect",
  "gzip",
  "deflate",
  "json",
  "form",
  "multipart",
  "stream",
  "streaming",
  "sse",
  "server-sent-events",
  "websocket",
  "ws",
  "wss",
  "cookie",
  "cookie-jar",
  "proxy",
  "connect",
  "socks5",
  "h2c",
  "http2-multiplexing",
  "rfc6265",
  "rfc6455",
  "rfc1928",
  "rfc7578",
  "rfc9110",
  "rfc9112",
  "rfc9113",
  "moonbit",
]

description = "An HTTP and WebSocket client for MoonBit."

source = "src"

import {
  "moonbitstack/moonnet@0.1.11",
  "moonbitstack/moontls@0.9.15",
  "moonbitstack/mooncred@0.6.10",
  "moonbitstack/moonhttp@0.15.9",
  "moonbitstack/moonurl@0.2.5",
  "moonbitstack/moonzip@0.3.7",
  "moonbitstack/moonbase@0.4.3",
  "moonbitstack/moonmime@0.2.3",
  "moonbitstack/moondate@0.1.5",
  "moonbitstack/mooncrypt@0.4.12",
  "moonbitstack/moonseed@0.1.1",
  "moonbitlang/async@0.22.5",
}
