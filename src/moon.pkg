// An HTTP client: HTTP Semantics, RFC 9110: https://www.rfc-editor.org/rfc/rfc9110
// HTTP/1.1, RFC 9112: https://www.rfc-editor.org/rfc/rfc9112
// HTTP/2, RFC 9113: https://www.rfc-editor.org/rfc/rfc9113
//
// Connections are moonnet's, which has sockets on the native and wasm backends only, so the
// transport files are limited to those two; the host's `fetch` carries the js backend, and the
// shapes and rules both hosts share compile everywhere the package does.
import {
  "moonbitstack/moonnet/tcp",
  "moonbitstack/moonnet/udp",
  "moonbitstack/moontls/tls",
  "moonbitstack/mooncred/x509",
  "moonbitstack/mooncred/roots",
  "moonbitstack/moonhttp/http1",
  "moonbitstack/moonhttp/http2",
  "moonbitstack/moonhttp/header",
  "moonbitstack/moonhttp/http3",
  "moonbitstack/moonhttp/qpack",
  "moonbitstack/moonhttp/method",
  "moonbitstack/moonhttp/cookie",
  "moonbitstack/moonurl",
  "moonbitstack/moondate",
  "moonbitstack/moonbase/base64",
  "moonbitstack/moonzip/gzip",
  "moonbitstack/moonzip/zlib",
  "moonbitstack/moonzip/deflate",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/cond_var",
  "moonbitlang/async/js_async",
  "moonbitlang/core/cmp",
  "moonbitlang/core/bench",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

import {
  "moonbitstack/moonfetch",
  "moonbitstack/moonmime",
  "moonbitstack/moonnet/tcp",
  "moonbitstack/moonnet/udp",
  "moonbitstack/moonurl",
  "moonbitstack/moontls/tls",
  "moonbitstack/moontls/alert",
  "moonbitstack/mooncred/x509",
  "moonbitstack/moonhttp/http1",
  "moonbitstack/moonhttp/http2",
  "moonbitstack/moonhttp/header",
  "moonbitstack/moonhttp/method",
  "moonbitstack/moonzip/gzip",
  "moonbitstack/moonzip/zlib",
  "moonbitstack/moonzip/deflate",
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
} for "test"

warnings = "-29"

options(
  targets: {
    "body.mbt": [ "native", "wasm", "js" ],
    "chunk.mbt": [ "native", "wasm", "js" ],
    "defaults.mbt": [ "native", "wasm", "js" ],
    "jar.mbt": [ "native", "wasm", "js" ],
    "limits.mbt": [ "native", "wasm", "js" ],
    "origin.mbt": [ "native", "wasm", "js" ],
    "payload.mbt": [ "native", "wasm", "js" ],
    "psl.mbt": [ "native", "wasm", "js" ],
    "psl_data.mbt": [ "native", "wasm", "js" ],
    "redirect.mbt": [ "native", "wasm", "js" ],
    "wire.mbt": [ "native", "wasm", "js" ],
    "response.mbt": [ "native", "wasm", "js" ],
    "client.mbt": [ "native", "wasm" ],
    "pool.mbt": [ "native", "wasm" ],
    "h1.mbt": [ "native", "wasm" ],
    "h2.mbt": [ "native", "wasm" ],
    "h3.mbt": [ "native", "wasm" ],
    "stream.mbt": [ "native", "wasm" ],
    "proxy.mbt": [ "native", "wasm" ],
    "transport.mbt": [ "native", "wasm" ],
    "client.js.mbt": [ "js" ],
    "stream.js.mbt": [ "js" ],
    "fetch.js.mbt": [ "js" ],
    "wire_test.mbt": [ "native", "wasm", "js" ],
    "body_test.mbt": [ "native", "wasm" ],
    "jar_test.mbt": [ "native", "wasm" ],
    "fetch_test.mbt": [ "native", "wasm" ],
    "server_test.mbt": [ "native", "wasm" ],
    "fixtures_test.mbt": [ "native", "wasm" ],
    "stream_test.mbt": [ "native", "wasm" ],
    "proxy_test.mbt": [ "native", "wasm" ],
    "stress_test.mbt": [ "native" ],
    "multiplex_test.mbt": [ "native" ],
    "h3_test.mbt": [ "native" ],
    "js_test.mbt": [ "js" ],
  },
)
