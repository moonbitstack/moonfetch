name = "moonbitstack/moonfetch"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonfetch"

license = "Apache-2.0"

keywords = [
  "http",
  "http3",
  "h3",
  "quic",
  "rfc9114",
  "rfc9000",
  "flow-control",
  "receive-window",
  "browser",
  "browser-fetch",
  "node",
  "javascript",
  "wasm",
  "rfc6265bis",
  "http-client",
  "client",
  "fetch",
  "requests",
  "httpx",
  "reqwest",
  "async",
  "http1",
  "http2",
  "https",
  "tls",
  "alpn",
  "redirect",
  "gzip",
  "deflate",
  "json",
  "form",
  "multipart",
  "stream",
  "streaming",
  "sse",
  "server-sent-events",
  "websocket",
  "ws",
  "wss",
  "cookie",
  "cookie-jar",
  "proxy",
  "connect",
  "socks5",
  "h2c",
  "http2-multiplexing",
  "rfc6265",
  "rfc6455",
  "rfc1928",
  "rfc7578",
  "rfc9110",
  "rfc9112",
  "rfc9113",
  "rfc7838",
  "alt-svc",
  "moonbit",
]

description = "An HTTP and WebSocket client for MoonBit, on native, wasm and the browser."

source = "src"

import {
  "moonbitstack/moonnet@0.2.0",
  "moonbitstack/moontls@0.9.17",
  "moonbitstack/mooncred@0.7.0",
  "moonbitstack/moonhttp@0.16.0",
  "moonbitstack/moonvar@0.3.0",
  "moonbitstack/moonjson@0.5.0",
  "moonbitstack/moonurl@0.3.0",
  "moonbitstack/moonzip@0.4.0",
  "moonbitstack/moonbase@0.5.0",
  "moonbitstack/moonmime@0.3.0",
  "moonbitstack/moondate@0.1.7",
  "moonbitstack/mooncrypt@0.5.0",
  "moonbitstack/moonseed@0.2.0",
  "moonbitlang/async@0.22.5",
}
